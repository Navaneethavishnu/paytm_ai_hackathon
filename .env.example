# Copy to .env and fill in. Never commit .env (it is gitignored; this file is not).
SARVAM_API_KEY=your_sarvam_key_here
LLM_PROVIDER=sarvam            # only sarvam is wired up
LLM_MODEL=sarvam-105b          # intake + investigate (tool calls)
LLM_REPLY_MODEL=sarvam-105b-conversations   # merchant replies (fast, no reasoning)
LLM_MAX_TOKENS=2048            # sarvam-105b reasoning tokens count toward this
LLM_OFFLINE=false              # true = never call Sarvam (deterministic fallbacks)

DATABASE_URL=sqlite:///./msa.db
CHECKPOINT_DB=checkpoints.db   # paused approval cases survive restarts
POLICY_FILE=policy/policy.yaml
DEMO_NOW=2026-11-15T10:00:00   # fixed demo clock

# API
OPS_TOKEN=change-me-ops-token  # X-Ops-Token for approvals, reset, system events
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MIN=20

# Demo behaviour
MOCK_FAILURE_RATE=0.0          # 0.0-1.0, random tool failures (chaos testing)
DEMO_MODE=false                # true = replay cached LLM answers from demo_assets/llm_cache.json
